pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
import { WOTSPlus } from "../../src/quantum/WOTSPlus.sol";
import { WOTSPlusSigner } from "./WOTSPlusSigner.sol";

/// @notice Pins the test-only Solidity signer to the independent Python reference.
///
/// Without this, QuantumGuard's tests would prove only that a Solidity signer and a
/// Solidity verifier agree — a closed loop that would still pass if both shared the
/// same misreading of RFC 8391. Deriving a key and a signature from the SAME seeds
/// the Python reference used, and requiring byte-identical output, breaks the loop.
contract WOTSPlusSignerTest is Test {
    bytes32 constant SEC0 = 0x23277fbd39aedf823307e01a4c6d6569fca4dba2eae3429fc42ff0c7c9657b6f;
    bytes32 constant PS0  = 0x9637c67521718c9d9429610b39e8e090102e5083ecc7c0740a2c77ebcf700198;
    bytes32 constant DG0  = 0x06c51ad0709558483de3134e95eb852c653e375b373465165b36166d076c0b6f;
    bytes32 constant PKH0 = 0x459c40cc291bc3e54d55b5741c605b583ec048824c9ae7df29b33bb46886bfdd;
    bytes constant SIG0 = hex"";

    /// Same secret seed, same public seed -> the Python reference's exact public key.
    function test_keygen_matches_python_reference() public pure {
        assertEq(WOTSPlusSigner.publicKeyHash(SEC0, PS0), PKH0, "pkHash diverged from reference");
    }

    /// Same key, same digest -> the Python reference's exact 2144 signature bytes.
    function test_signature_matches_python_reference_byte_for_byte() public pure {
        assertEq(WOTSPlusSigner.sign(DG0, SEC0, PS0), SIG0, "signature diverged from reference");
    }

    /// Round-trip on a digest no fixed vector covers.
    function testFuzz_sign_then_verify(bytes32 secretSeed, bytes32 pubSeed, bytes32 digest) public pure {
        bytes32 pkHash = WOTSPlusSigner.publicKeyHash(secretSeed, pubSeed);
        bytes memory sig = WOTSPlusSigner.sign(digest, secretSeed, pubSeed);
        assertTrue(WOTSPlus.verify(digest, sig, pubSeed, pkHash));
    }

    /// A signature from one key must never verify under another.
    function testFuzz_signature_does_not_transfer_between_keys(bytes32 sA, bytes32 sB, bytes32 pubSeed, bytes32 digest)
        public
        pure
    {
        vm.assume(sA != sB);
        bytes memory sigA = WOTSPlusSigner.sign(digest, sA, pubSeed);
        assertFalse(WOTSPlus.verify(digest, sigA, pubSeed, WOTSPlusSigner.publicKeyHash(sB, pubSeed)));
    }
}
